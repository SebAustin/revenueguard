# RevenueGuard — required environment variables.
# Copy to `.env` and fill in. NEVER commit the real .env (see .gitignore).

# --- Google Cloud / Vertex AI (the only LLM provider allowed by the rules) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# ADK reads this to route the model through Vertex AI rather than AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=true

# --- BigQuery (the warehouse — no Snowflake/Redshift in the shipped product) ---
RG_DATASET=revenueguard_demo
# Fixed "as-of" date so freshness + leak logic is deterministic in the demo.
RG_AS_OF_DATE=2026-06-08

# --- Fivetran MCP (the load-bearing partner integration) ---
# Generate at https://fivetran.com/dashboard/user/api-config
FIVETRAN_API_KEY=your-fivetran-api-key
FIVETRAN_API_SECRET=your-fivetran-api-secret
# Set true only when you want the agent to be able to trigger a re-sync.
FIVETRAN_ALLOW_WRITES=true
